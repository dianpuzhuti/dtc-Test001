<header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-[37px] z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- Logo & Medical Dermatology Tag -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-600 to-slate-900 flex items-center justify-center text-white font-black text-xl shadow-md group-hover:scale-105 transition-transform">
        P
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-black text-lg sm:text-xl text-slate-900 tracking-tight">
            {{ section.settings.brand_name | default: 'PeptiDerm' }}
          </span>
          <span class="text-xs text-sky-600 font-extrabold">™</span>
        </div>
        <span class="text-[10px] uppercase font-bold text-slate-600 tracking-widest block -mt-0.5">
          {{ section.settings.brand_tagline | default: 'Clinical Dermatology Lab' }}
        </span>
      </div>
    </a>

    <!-- Clinical Credentials Badges -->
    <div class="hidden lg:flex items-center gap-6 text-xs text-slate-600 font-semibold">
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>7重高纯仿生多肽</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
        <span>28天双盲临床验证</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>99.8% 敏感肌耐受</span>
      </div>
    </div>

    <!-- Right Header Action: Shopify Cart Drawer Trigger & Fast Checkout Button -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        onclick="window.openShopifyCartDrawer ? window.openShopifyCartDrawer() : (window.location.href='/cart')"
        class="bg-slate-900 hover:bg-sky-950 text-white font-black text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-xl shadow-xs transition-all flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <span>立即选购 ($29起)</span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "头部导航栏",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "品牌名称",
      "default": "PeptiDerm"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "品牌副标",
      "default": "Clinical Dermatology Lab"
    }
  ]
}
{% endschema %}
