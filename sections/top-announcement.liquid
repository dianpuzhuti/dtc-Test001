{%- if section.settings.show_bar -%}
<div class="bg-gradient-to-r from-slate-900 via-sky-950 to-slate-900 text-white text-xs py-2.5 px-4 border-b border-sky-900/60 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    
    <div class="hidden md:flex items-center gap-2 text-sky-300 font-bold">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{{ section.settings.left_badge | default: 'GMP MEDICAL LAB CERTIFIED • SWISS SGS DERMATOLOGICALLY TESTED' }}</span>
    </div>

    <div class="flex-1 text-center font-extrabold tracking-wide flex items-center justify-center gap-2">
      <span class="bg-sky-500 text-slate-950 text-[10px] font-black uppercase px-2 py-0.5 rounded shadow-2xs">
        {{ section.settings.tag | default: 'FLASH SPECIAL' }}
      </span>
      <span>{{ section.settings.message | default: 'LIMITED TIME: UP TO 41% OFF + FREE CRYO SPATULA WITH 50ML/100ML + FREE WORLDWIDE SHIPPING' }}</span>
    </div>

    <div class="hidden md:flex items-center gap-3 text-slate-300 font-medium">
      <span>30-Day Money-Back Guarantee</span>
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Top Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "FLASH SPECIAL"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "LIMITED TIME: UP TO 41% OFF + FREE CRYO SPATULA WITH 50ML/100ML + FREE WORLDWIDE SHIPPING"
    },
    {
      "type": "text",
      "id": "left_badge",
      "label": "Left Guarantee Badge",
      "default": "GMP MEDICAL LAB CERTIFIED • SWISS SGS DERMATOLOGICALLY TESTED"
    }
  ]
}
{% endschema %}
