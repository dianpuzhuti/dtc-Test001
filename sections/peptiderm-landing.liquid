{% assign current_product = section.settings.product | default: collections.all.products.first | default: all_products.first %}
{% assign default_variant = current_product.selected_or_first_available_variant %}

<script>
  window.peptidermShopifyProducts = [
    {% if section.settings.product != blank %}
      {
        id: {{ section.settings.product.id | json }},
        title: {{ section.settings.product.title | json }},
        handle: {{ section.settings.product.handle | json }},
        variants: [
          {% for v in section.settings.product.variants %}
            {
              id: {{ v.id | json }},
              title: {{ v.title | json }},
              price: {{ v.price | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      },
    {% endif %}
    {% for p in collections.all.products limit: 10 %}
      {
        id: {{ p.id | json }},
        title: {{ p.title | json }},
        handle: {{ p.handle | json }},
        variants: [
          {% for v in p.variants %}
            {
              id: {{ v.id | json }},
              title: {{ v.title | json }},
              price: {{ v.price | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>

<!-- Hidden Native Shopify Cart/Checkout Form -->
<form action="/cart/add" method="post" enctype="multipart/form-data" id="peptiderm-add-to-cart-form" class="hidden">
  <input type="hidden" name="id" id="peptiderm-variant-id-input" value="{{ default_variant.id | default: '' }}">
  <input type="hidden" name="quantity" id="peptiderm-quantity-input" value="1">
  <input type="hidden" name="return_to" value="/checkout">
</form>

<div id="peptiderm-shopify-root" class="w-full text-slate-900 bg-white font-sans antialiased selection:bg-sky-200 selection:text-sky-950">

  <!-- ========================================== -->
  <!-- 1. HERO SECTION & VARIANT SELECTOR -->
  <!-- ========================================== -->
  <section class="bg-gradient-to-b from-sky-50/60 via-white to-slate-50/50 py-8 sm:py-14 px-4 sm:px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Gallery & Clinical Proof -->
      <div class="lg:col-span-6 space-y-4">
        
        <!-- Main Product Stage -->
        <div class="relative aspect-4/3 rounded-3xl overflow-hidden border border-slate-200/90 shadow-xl bg-white p-6 flex items-center justify-center group">
          <img
            id="hero-active-img"
            src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=85"
            alt="PeptiDerm Cellular Renewal Multi-Peptide Cream"
            class="w-full h-full object-contain transform group-hover:scale-105 transition-transform duration-500"
          >
          <div class="absolute top-4 left-4 bg-slate-900/90 backdrop-blur-md text-white text-[10px] sm:text-[11px] font-black px-3.5 py-1.5 rounded-full border border-slate-700 shadow-md flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            <span data-i18n="hero.labTag">7 BIO-MIMETIC SIGNAL PEPTIDES</span>
          </div>
          <div class="absolute bottom-4 right-4 bg-sky-600/90 backdrop-blur-md text-white text-[10px] sm:text-[11px] font-black px-3 py-1 rounded-full shadow-md flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            <span data-i18n="hero.clinicalProofTag">28-Day Clinical Trial Verified</span>
          </div>
        </div>

        <!-- 4 Gallery Thumbnails -->
        <div class="grid grid-cols-4 gap-2.5">
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=85', this)" class="gallery-thumb border-2 border-sky-600 ring-2 ring-sky-600/20 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer">
            <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=300&q=85" alt="Core Airless Bottle" class="w-full h-full object-cover rounded-lg">
          </button>
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1608248597359-00958197779d?auto=format&fit=crop&w=1200&q=85', this)" class="gallery-thumb border-2 border-slate-200 hover:border-slate-300 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer opacity-70 hover:opacity-100">
            <img src="https://images.unsplash.com/photo-1608248597359-00958197779d?auto=format&fit=crop&w=300&q=85" alt="Clinical Cream Texture" class="w-full h-full object-cover rounded-lg">
          </button>
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=1200&q=85', this)" class="gallery-thumb border-2 border-slate-200 hover:border-slate-300 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer opacity-70 hover:opacity-100">
            <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=300&q=85" alt="Cleanroom Laboratory" class="w-full h-full object-cover rounded-lg">
          </button>
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1200&q=85', this)" class="gallery-thumb border-2 border-slate-200 hover:border-slate-300 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer opacity-70 hover:opacity-100">
            <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=300&q=85" alt="Board-Certified Dermatologist" class="w-full h-full object-cover rounded-lg">
          </button>
        </div>

        <!-- 4 Clinical Benchmarks -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs">
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-sky-700 font-black block text-sm">-42.8%</span>
            <span class="text-slate-500 text-[10px]" data-i18n="hero.benchmarks.wrinkle">Wrinkle Volume</span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-sky-700 font-black block text-sm">+68.4%</span>
            <span class="text-slate-500 text-[10px]" data-i18n="hero.benchmarks.collagen">Dermal Collagen</span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-sky-700 font-black block text-sm">99.8%</span>
            <span class="text-slate-500 text-[10px]" data-i18n="hero.benchmarks.tolerance">Tolerance Rate</span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-emerald-700 font-black block text-sm">3.2s</span>
            <span class="text-slate-500 text-[10px]" data-i18n="hero.benchmarks.absorption">Matte Absorption</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Copy & Shopify Variant Selector -->
      <div class="lg:col-span-6 space-y-6">
        
        <div class="space-y-2">
          <!-- Rating -->
          <div class="flex items-center gap-2">
            <div class="flex items-center text-amber-400">
              ★★★★★
            </div>
            <span class="text-xs font-bold text-slate-800">4.96 / 5.0</span>
            <span class="text-xs text-slate-400" data-i18n="hero.ratingText">(3,842 Verified Clinical Reviews)</span>
          </div>

          <div class="inline-flex items-center gap-1.5 bg-sky-100 text-sky-900 text-xs font-black px-3.5 py-1 rounded-full border border-sky-200">
            <span data-i18n="hero.headlineLead">CLINICAL BREAKTHROUGH • CELLULAR REGENERATION</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-snug" data-i18n="hero.headlineTitle">
            {{ section.settings.heading | default: '7 Bio-Mimetic Peptides • Rebuild Youthful Collagen in 28 Days' }}
          </h1>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed" data-i18n="hero.headlineSubtitle">
            {{ section.settings.subheading | default: 'Resolve the anti-aging contradiction: potent clinical wrinkle repair without barrier damage, peeling, or irritation. Experience 99.8% physiological tolerance and -42.8% wrinkle depth reduction.' }}
          </p>
        </div>

        <!-- 3-Tier Interactive Variant Selector Box -->
        <div class="space-y-3 bg-slate-50 border border-slate-200 rounded-3xl p-4 sm:p-5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-extrabold text-slate-900 uppercase tracking-wider" data-i18n="hero.selectCourse">Select Course (Shopify Variant Matrix):</span>
            <span class="text-emerald-700 font-bold" data-i18n="hero.stockLeft">In Stock • Dispatched in 24h</span>
          </div>

          <div class="grid grid-cols-3 gap-2.5">
            
            <!-- 30ml Starter -->
            <button
              type="button"
              onclick="selectThemeVariant('30ml', 29, 49, null, '{{ current_product.variants[0].id | default: '' }}')"
              id="var-btn-30ml"
              class="variant-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-sky-400 transition-all cursor-pointer"
            >
              <div class="text-xs font-black text-slate-900">30ml</div>
              <div class="text-sm font-black text-sky-700 mt-1">$29.00 <span class="text-[10px] text-slate-400 line-through font-normal">$49.00</span></div>
              <div class="text-[10px] text-slate-500 mt-0.5">Save $20</div>
            </button>

            <!-- 50ml Most Popular -->
            <button
              type="button"
              onclick="selectThemeVariant('50ml', 49, 79, null, '{{ current_product.variants[1].id | default: default_variant.id }}')"
              id="var-btn-50ml"
              class="variant-btn p-3 rounded-2xl border-2 text-left bg-sky-50/80 border-sky-600 ring-2 ring-sky-600/20 shadow-sm transition-all cursor-pointer relative"
            >
              <div class="absolute -top-2.5 right-2 bg-amber-500 text-slate-950 text-[9px] font-black px-2 py-0.5 rounded-full truncate max-w-[95%]">
                82% CHOOSE THIS
              </div>
              <div class="text-xs font-black text-slate-900">50ml</div>
              <div class="text-sm font-black text-sky-700 mt-1">$49.00 <span class="text-[10px] text-slate-400 line-through font-normal">$79.00</span></div>
              <div class="text-[10px] text-emerald-700 font-bold mt-0.5">Save $30 + Free Gifts</div>
            </button>

            <!-- 100ml Best Value -->
            <button
              type="button"
              onclick="selectThemeVariant('100ml', 79, 129, null, '{{ current_product.variants[2].id | default: '' }}')"
              id="var-btn-100ml"
              class="variant-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-sky-400 transition-all cursor-pointer relative"
            >
              <div class="absolute -top-2.5 right-2 bg-sky-900 text-white text-[9px] font-black px-2 py-0.5 rounded-full truncate max-w-[95%]">
                BEST VALUE
              </div>
              <div class="text-xs font-black text-slate-900">100ml</div>
              <div class="text-sm font-black text-sky-700 mt-1">$79.00 <span class="text-[10px] text-slate-400 line-through font-normal">$129.00</span></div>
              <div class="text-[10px] text-slate-500 mt-0.5">Save $50 • Free Full Size</div>
            </button>

          </div>

          <!-- Active Variant Summary Strip -->
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <div>
              <span class="text-slate-500">Selected: </span>
              <strong id="selected-variant-label" class="text-slate-900 font-black">50ml Core Cellular Treatment (6-8 Weeks)</strong>
            </div>
            <div class="text-right">
              <span id="selected-price-display" class="text-xl font-black text-sky-700">$49.00</span>
              <span id="selected-compare-display" class="text-xs text-slate-400 line-through ml-1">$79.00</span>
            </div>
          </div>

          <div id="selected-variant-gifts" class="bg-white border border-slate-200/80 rounded-xl p-2.5 space-y-1 text-[11px]">
            <span class="font-bold text-sky-900 block">Package Inclusions:</span>
            <ul class="space-y-0.5 text-slate-600">
              <li>✓ FREE Cryo Zinc-Alloy Sculpting Spatula ($18 Value)</li>
              <li>✓ FREE 28-Day Cellular Skin Tracking Journal</li>
              <li>✓ FREE Global Tracked Express Shipping</li>
            </ul>
          </div>

        </div>

        <!-- Buy Action Button -->
        <div class="space-y-3">
          <button
            type="button"
            onclick="openShopifyCartDrawer()"
            class="w-full bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 text-slate-950 font-black text-base sm:text-lg py-4 px-6 rounded-2xl shadow-xl transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98"
          >
            <span data-i18n="hero.ctaButton">Order Now • 30-Day Money-Back Guarantee</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>

          <div class="flex items-center justify-center gap-4 text-xs text-slate-500 font-medium">
            <span>✓ Free Express Shipping</span>
            <span>•</span>
            <span>✓ 30-Day Money-Back</span>
            <span>•</span>
            <span>✓ 100% Authentic Lab Direct</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- 2. UPGRADED CLINICAL 28-DAY VISUAL COMPARISON -->
  <!-- ========================================== -->
  <section class="bg-slate-900 text-white py-12 sm:py-16 px-4 sm:px-6 border-b border-slate-800">
    <div class="max-w-6xl mx-auto space-y-8 sm:space-y-10">
      
      <!-- Header -->
      <div class="text-center space-y-2.5 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-1.5 bg-sky-500/20 text-sky-300 text-xs font-black px-3.5 py-1 rounded-full border border-sky-500/30 uppercase tracking-wider">
          <span data-i18n="comparison.badge">28-DAY OPTICAL TOPOGRAPHY PROOF</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-white" data-i18n="comparison.title">Visual Proof: Before & After 28-Day Clinical Trial</h2>
        <p class="text-slate-400 text-xs sm:text-sm" data-i18n="comparison.subtitle">Double-blind German PRIMOS 3D micro-optical profilometry tracking cellular dermal density and wrinkle volume reduction.</p>
      </div>

      <!-- Concern Tabs & View Mode Switcher -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <!-- 3 Clinical Concern Buttons -->
        <div class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0 no-scrollbar">
          <button
            type="button"
            onclick="setComparisonConcern('nasolabial')"
            id="concern-tab-nasolabial"
            class="concern-tab-btn px-4 py-2 rounded-xl text-xs font-black transition-all bg-sky-600 text-white shadow-md cursor-pointer whitespace-nowrap"
          >
            Smile Folds (-42.8%)
          </button>
          <button
            type="button"
            onclick="setComparisonConcern('crowsfeet')"
            id="concern-tab-crowsfeet"
            class="concern-tab-btn px-4 py-2 rounded-xl text-xs font-black transition-all text-slate-400 hover:text-white cursor-pointer whitespace-nowrap"
          >
            Eye Contour (-38.5%)
          </button>
          <button
            type="button"
            onclick="setComparisonConcern('forehead')"
            id="concern-tab-forehead"
            class="concern-tab-btn px-4 py-2 rounded-xl text-xs font-black transition-all text-slate-400 hover:text-white cursor-pointer whitespace-nowrap"
          >
            Collagen Density (+68.4%)
          </button>
        </div>

        <!-- View Mode: Slider vs Side-by-Side -->
        <div class="flex items-center bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs font-bold shrink-0">
          <button
            type="button"
            onclick="setComparisonViewMode('slider')"
            id="mode-btn-slider"
            class="px-3 py-1.5 rounded-lg transition-all bg-slate-800 text-sky-300 cursor-pointer"
            data-i18n="comparison.sliderTab"
          >
            Interactive Split Slider
          </button>
          <button
            type="button"
            onclick="setComparisonViewMode('sideBySide')"
            id="mode-btn-sideBySide"
            class="px-3 py-1.5 rounded-lg transition-all text-slate-400 hover:text-white cursor-pointer"
            data-i18n="comparison.sideBySideTab"
          >
            Side-by-Side Diagnostic Proof
          </button>
        </div>
      </div>

      <!-- Main Comparison Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Left: Image Viewer (Slider / Side-by-Side) -->
        <div class="lg:col-span-8 bg-slate-950 rounded-3xl p-4 border border-slate-800 shadow-2xl flex flex-col justify-between space-y-4">
          
          <!-- View 1: Interactive Clip-Path Slider -->
          <div id="comparison-slider-view" class="relative aspect-4/3 sm:aspect-16/10 rounded-2xl overflow-hidden select-none touch-none bg-slate-900 border border-slate-800">
            
            <!-- Bottom Layer: Day 28 Post-Treatment -->
            <img
              id="comparison-after-img"
              src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=1200&q=85"
              alt="Day 28 Skin Treatment"
              class="absolute inset-0 w-full h-full object-cover object-center"
            >
            <div class="absolute top-3 right-3 bg-sky-600/90 backdrop-blur-md text-white text-[10px] sm:text-[11px] font-black px-3 py-1 rounded-full shadow-md z-10">
              DAY 28 • PEPTIDERM
            </div>

            <!-- Top Layer: Day 0 Baseline with CSS clip-path (Zero distortion) -->
            <div
              id="liquid-before-clip-layer"
              class="absolute inset-0 pointer-events-none transition-none"
              style="clip-path: inset(0 50% 0 0);"
            >
              <img
                id="comparison-before-img"
                src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=1200&q=85"
                alt="Day 0 Baseline Skin"
                class="absolute inset-0 w-full h-full object-cover object-center"
              >
              <div class="absolute top-3 left-3 bg-slate-900/90 backdrop-blur-md text-slate-200 text-[10px] sm:text-[11px] font-black px-3 py-1 rounded-full shadow-md z-10">
                DAY 0 • BASELINE
              </div>
            </div>

            <!-- Vertical Divider Handle -->
            <div
              id="liquid-slider-divider"
              class="absolute top-0 bottom-0 w-1 bg-white shadow-2xl z-20 pointer-events-none"
              style="left: 50%; transform: translateX(-50%);"
            >
              <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 sm:w-10 sm:h-10 bg-white text-slate-950 rounded-full flex items-center justify-center shadow-2xl border-2 border-sky-600 font-black text-xs">
                ⇄
              </div>
            </div>

            <!-- Full-cover Input Range Slider -->
            <input
              type="range"
              min="0"
              max="100"
              value="50"
              oninput="onSliderRangeInput(this.value)"
              class="absolute inset-0 opacity-0 cursor-ew-resize w-full h-full z-30 m-0 p-0"
              aria-label="Interactive Skin Comparison Slider"
            >
          </div>

          <!-- View 2: Side-by-Side Dual View (Hidden by default) -->
          <div id="comparison-sbs-view" class="hidden grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
              <div class="relative aspect-4/3 rounded-2xl overflow-hidden border border-slate-800 bg-slate-900">
                <img id="sbs-before-img" src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=800&q=85" alt="Day 0" class="w-full h-full object-cover">
                <div class="absolute top-2.5 left-2.5 bg-slate-900/90 text-slate-300 text-[10px] font-black px-2.5 py-1 rounded-full">
                  DAY 0 • BASELINE
                </div>
              </div>
              <p id="sbs-before-desc" class="text-xs text-slate-400 leading-relaxed">Day 0: Deepened nasolabial creases, loss of dermal rebound, uneven skin texture.</p>
            </div>
            <div class="space-y-2">
              <div class="relative aspect-4/3 rounded-2xl overflow-hidden border border-sky-600/50 bg-slate-900">
                <img id="sbs-after-img" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&q=85" alt="Day 28" class="w-full h-full object-cover">
                <div class="absolute top-2.5 left-2.5 bg-sky-600 text-white text-[10px] font-black px-2.5 py-1 rounded-full">
                  DAY 28 • PEPTIDERM
                </div>
              </div>
              <p id="sbs-after-desc" class="text-xs text-slate-300 leading-relaxed font-medium">Day 28: Plumped dermal extracellular matrix, lifted fold contours, smooth luminous finish.</p>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs text-slate-400 px-1 pt-1">
            <span data-i18n="comparison.dragHint">⇄ Drag slider left / right to compare</span>
            <span class="text-sky-400 font-semibold">German PRIMOS 3D Topography</span>
          </div>
        </div>

        <!-- Right: Clinical Diagnosis & Data Card -->
        <div class="lg:col-span-4 bg-slate-950/90 border border-slate-800 rounded-3xl p-6 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div>
              <span id="comparison-days" class="text-[10px] font-black uppercase tracking-wider text-sky-400">Day 28 Clinical Topography</span>
              <h3 id="comparison-title" class="font-extrabold text-white text-lg sm:text-xl mt-1">Nasolabial Smile Fold Depth & Volume</h3>
            </div>

            <!-- Big Stat Box -->
            <div class="bg-sky-950/60 border border-sky-800/80 rounded-2xl p-4 flex items-baseline justify-between">
              <div>
                <span id="comparison-stat" class="text-3xl sm:text-4xl font-black text-sky-400">-42.8%</span>
                <span class="text-xs text-slate-300 block mt-0.5 font-medium">Statistically Significant</span>
              </div>
              <span class="text-xs text-emerald-400 font-bold bg-emerald-950/80 px-2.5 py-1 rounded border border-emerald-800">
