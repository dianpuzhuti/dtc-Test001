{% assign current_product = section.settings.product | default: collections.all.products.first | default: all_products.first %}
{% assign default_variant = current_product.selected_or_first_available_variant %}

<script>
  window.peptidermShopifyProducts = [
    {% if section.settings.product != blank %}
      {
        id: {{ section.settings.product.id | json }},
        title: {{ section.settings.product.title | json }},
        handle: {{ section.settings.product.handle | json }},
        variants: [
          {% for v in section.settings.product.variants %}
            {
              id: {{ v.id | json }},
              title: {{ v.title | json }},
              price: {{ v.price | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      },
    {% endif %}
    {% for p in collections.all.products limit: 10 %}
      {
        id: {{ p.id | json }},
        title: {{ p.title | json }},
        handle: {{ p.handle | json }},
        variants: [
          {% for v in p.variants %}
            {
              id: {{ v.id | json }},
              title: {{ v.title | json }},
              price: {{ v.price | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>

<!-- Hidden Native Shopify Cart/Checkout Form -->
<form action="/cart/add" method="post" enctype="multipart/form-data" id="peptiderm-add-to-cart-form" class="hidden">
  <input type="hidden" name="id" id="peptiderm-variant-id-input" value="{{ default_variant.id | default: '' }}">
  <input type="hidden" name="quantity" id="peptiderm-quantity-input" value="1">
  <input type="hidden" name="return_to" value="/checkout">
</form>

<div id="peptiderm-shopify-root" class="w-full text-slate-900 bg-white font-sans antialiased selection:bg-sky-200 selection:text-sky-950">
  
  {% assign brand_title = section.settings.brand_name | default: current_product.vendor | default: shop.name | default: 'PeptiDerm' %}
  {% assign brand_sub = section.settings.brand_tagline | default: 'Clinical Dermatology Laboratories' %}
  {% assign promo_badge = section.settings.announcement_badge | default: 'FLASH SPECIAL' %}
  {% assign promo_text = section.settings.announcement_text | default: 'UP TO 41% OFF • FREE CRYO SPATULA WITH 50ML/100ML • WORLDWIDE EXPRESS SHIPPING' %}
  {% assign left_guarantee = section.settings.top_left_text | default: 'GMP MEDICAL LAB CERTIFIED • SWISS SGS DERMATOLOGICALLY TESTED' %}
  {% assign right_guarantee = section.settings.top_right_text | default: '30-Day Money-Back Guarantee' %}

  <!-- ========================================== -->
  <!-- 0A. DYNAMIC TOP ANNOUNCEMENT BAR (NO HARDCODING, NO WRAPPING BUGS) -->
  <!-- ========================================== -->
  <div class="bg-gradient-to-r from-slate-950 via-sky-950 to-slate-950 text-white text-xs py-2 px-3 sm:px-4 border-b border-sky-900/60 sticky top-0 z-50 overflow-hidden">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
      
      <!-- Left Clinical Guarantee -->
      {% if left_guarantee != blank %}
        <div class="hidden xl:flex items-center gap-2 text-sky-300 font-bold text-[11px] shrink-0 whitespace-nowrap">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{{ left_guarantee }}</span>
        </div>
      {% endif %}

      <!-- Center Dynamic Announcement (Single line guaranteed, never wraps into 8 lines) -->
      <div class="flex-1 flex items-center justify-center gap-2 min-w-0 overflow-hidden">
        {% if promo_badge != blank %}
          <span class="bg-sky-500 text-slate-950 text-[10px] font-black uppercase px-2 py-0.5 rounded shrink-0 shadow-2xs">
            {{ promo_badge }}
          </span>
        {% endif %}
        <span class="font-extrabold text-[11px] sm:text-xs text-white tracking-wide truncate">
          {{ promo_text }}
        </span>
      </div>

      <!-- Right Guarantee -->
      {% if right_guarantee != blank %}
        <div class="hidden lg:flex items-center gap-1.5 text-slate-300 text-[11px] font-semibold shrink-0 whitespace-nowrap">
          <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>{{ right_guarantee }}</span>
        </div>
      {% endif %}

    </div>
  </div>

  <!-- ========================================== -->
  <!-- 0B. DYNAMIC BRAND & LAB HEADER -->
  <!-- ========================================== -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-[33px] z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-18 flex items-center justify-between gap-4">
      
      <!-- Dynamic Brand Identity -->
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        {% if section.settings.logo_image != blank %}
          <img src="{{ section.settings.logo_image | image_url: width: 100 }}" alt="{{ brand_title }}" class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl object-contain">
        {% else %}
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-sky-600 to-slate-900 flex items-center justify-center text-white font-black text-base sm:text-xl shadow-md shrink-0">
            {{ brand_title | slice: 0, 1 | upcase }}
          </div>
        {% endif %}
        <div class="min-w-0">
          <div class="flex items-center gap-1">
            <span class="font-black text-base sm:text-xl text-slate-900 tracking-tight truncate">
              {{ brand_title }}
            </span>
            <span class="text-[10px] sm:text-xs text-sky-600 font-extrabold">™</span>
          </div>
          {% if brand_sub != blank %}
            <span class="text-[9px] sm:text-[10px] uppercase font-bold text-slate-500 tracking-wider block -mt-0.5 truncate max-w-[180px] sm:max-w-xs">
              {{ brand_sub }}
            </span>
          {% endif %}
        </div>
      </div>

      <!-- Dynamic Feature Badges -->
      <div class="hidden xl:flex items-center gap-5 text-xs text-slate-600 font-semibold whitespace-nowrap">
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-sky-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span>{{ section.settings.feature_1_text | default: '7 Bio-Mimetic Signal Peptides' }}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-sky-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          <span>{{ section.settings.feature_2_text | default: '28-Day Clinical Trial Proof' }}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>{{ section.settings.feature_3_text | default: '99.8% Tolerance Rate' }}</span>
        </div>
      </div>

      <!-- Right Header Action Button -->
      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          onclick="openShopifyCartDrawer()"
          class="bg-slate-900 hover:bg-sky-950 text-white font-black text-xs sm:text-sm px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl shadow-xs transition-all flex items-center gap-2 cursor-pointer active:scale-98 whitespace-nowrap"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span>{{ section.settings.header_cta_text | default: 'Order Now' }}</span>
        </button>
      </div>

    </div>
  </header>

  <!-- ========================================== -->
  <!-- 1. HERO SECTION & VARIANT SELECTOR -->
  <!-- ========================================== -->
  <section class="bg-gradient-to-b from-sky-50/60 via-white to-slate-50/50 py-8 sm:py-14 px-4 sm:px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Gallery & Clinical Proof -->
      <div class="lg:col-span-6 space-y-4">
        
        <!-- Main Product Stage -->
        <div class="relative aspect-4/3 rounded-3xl overflow-hidden border border-slate-200/90 shadow-xl bg-white p-6 flex items-center justify-center group">
          <img
            id="hero-active-img"
            src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1200&q=80"
            alt="PeptiDerm Cellular Renewal Multi-Peptide Cream"
            class="w-full h-full object-contain transform group-hover:scale-105 transition-transform duration-500"
          >
          <div class="absolute top-4 left-4 bg-slate-900/90 backdrop-blur-md text-white text-[11px] font-black px-3.5 py-1.5 rounded-full border border-slate-700 shadow-md">
            7 BIO-MIMETIC SIGNAL PEPTIDES
          </div>
          <div class="absolute bottom-4 right-4 bg-sky-600/90 backdrop-blur-md text-white text-[11px] font-black px-3 py-1 rounded-full shadow-md">
            28-Day Clinical Trial Verified
          </div>
        </div>

        <!-- 4 Gallery Thumbnails -->
        <div class="grid grid-cols-4 gap-2.5">
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1200&q=80', this)" class="gallery-thumb border-2 border-sky-600 ring-2 ring-sky-600/20 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer">
            <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=300&q=80" alt="Core bottle" class="w-full h-full object-cover rounded-lg">
          </button>
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=1200&q=80', this)" class="gallery-thumb border-2 border-slate-200 hover:border-slate-300 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer opacity-70 hover:opacity-100">
            <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=300&q=80" alt="Texture" class="w-full h-full object-cover rounded-lg">
          </button>
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=1200&q=80', this)" class="gallery-thumb border-2 border-slate-200 hover:border-slate-300 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer opacity-70 hover:opacity-100">
            <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=300&q=80" alt="Lab" class="w-full h-full object-cover rounded-lg">
          </button>
          <button type="button" onclick="setHeroGalleryImage('https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1200&q=80', this)" class="gallery-thumb border-2 border-slate-200 hover:border-slate-300 rounded-xl overflow-hidden aspect-square p-1 bg-white cursor-pointer opacity-70 hover:opacity-100">
            <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=300&q=80" alt="Doctor" class="w-full h-full object-cover rounded-lg">
          </button>
        </div>

        <!-- 4 Quick Highlights -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs">
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-sky-700 font-black block text-sm">-42.8%</span>
            <span class="text-slate-500 text-[10px]">Wrinkle Volume</span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-sky-700 font-black block text-sm">+68.4%</span>
            <span class="text-slate-500 text-[10px]">Dermal Collagen</span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-sky-700 font-black block text-sm">99.8%</span>
            <span class="text-slate-500 text-[10px]">Tolerance Rate</span>
          </div>
          <div class="bg-white border border-slate-200/90 rounded-2xl p-2.5 shadow-2xs">
            <span class="text-emerald-700 font-black block text-sm">3-Sec</span>
            <span class="text-slate-500 text-[10px]">Matte Absorption</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Copy & Shopify Interactive Variant Selector -->
      <div class="lg:col-span-6 space-y-6">
        
        <div class="space-y-2">
          <!-- Rating -->
          <div class="flex items-center gap-2">
            <div class="flex items-center text-amber-400">
              ★★★★★
            </div>
            <span class="text-xs font-bold text-slate-800">4.96 / 5.0</span>
            <span class="text-xs text-slate-400">(3,842 Verified Clinical Reviews)</span>
          </div>

          <div class="inline-flex items-center gap-1.5 bg-sky-100 text-sky-900 text-xs font-black px-3.5 py-1 rounded-full border border-sky-200">
            <span>CLINICAL BREAKTHROUGH • CELLULAR REGENERATION</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-snug">
            {{ section.settings.heading | default: '7 Bio-Mimetic Peptides • Rebuild Youthful Collagen in 28 Days' }}
          </h1>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            {{ section.settings.subheading | default: 'Resolve the anti-aging contradiction: potent clinical wrinkle repair without barrier damage, peeling, or irritation. Experience 99.8% physiological tolerance and -42.8% wrinkle depth reduction.' }}
          </p>
        </div>

        <!-- 3-Tier Interactive Variant Selector Box -->
        <div class="space-y-3 bg-slate-50 border border-slate-200 rounded-3xl p-4 sm:p-5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-extrabold text-slate-900 uppercase tracking-wider">Select Course (Shopify Variant Matrix):</span>
            <span class="text-emerald-700 font-bold">In Stock • Dispatched in 24h</span>
          </div>

          <div class="grid grid-cols-3 gap-2.5">
            
            <!-- 30ml Starter -->
            <button
              type="button"
              onclick="selectThemeVariant('30ml', 29, 49, '30ml Discovery Starter Kit (2-3 Weeks Supply)', '{{ current_product.variants[0].id | default: '' }}')"
              id="var-btn-30ml"
              class="variant-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-sky-400 transition-all cursor-pointer"
            >
              <div class="text-xs font-black text-slate-900">30ml Starter</div>
              <div class="text-sm font-black text-sky-700 mt-1">$29 <span class="text-[10px] text-slate-400 line-through font-normal">$49</span></div>
              <div class="text-[10px] text-slate-500 mt-0.5">Save $20</div>
            </button>

            <!-- 50ml Most Popular -->
            <button
              type="button"
              onclick="selectThemeVariant('50ml', 49, 79, '50ml Core Treatment (Full 28-Day Cycle • FREE Cryo Spatula)', '{{ current_product.variants[1].id | default: default_variant.id }}')"
              id="var-btn-50ml"
              class="variant-btn p-3 rounded-2xl border-2 text-left bg-sky-50/80 border-sky-600 ring-2 ring-sky-600/20 shadow-sm transition-all cursor-pointer relative"
            >
              <div class="absolute -top-2.5 right-2 bg-amber-500 text-slate-950 text-[9px] font-black px-2 py-0.5 rounded-full">
                82% CHOOSE THIS
              </div>
              <div class="text-xs font-black text-slate-900">50ml Core Treatment</div>
              <div class="text-sm font-black text-sky-700 mt-1">$49 <span class="text-[10px] text-slate-400 line-through font-normal">$79</span></div>
              <div class="text-[10px] text-emerald-700 font-bold mt-0.5">Save $30 + Free Gifts</div>
            </button>

            <!-- 100ml Best Value -->
            <button
              type="button"
              onclick="selectThemeVariant('100ml', 79, 129, '100ml Clinical Course (3-4 Months • FREE 30ml + Spatula)', '{{ current_product.variants[2].id | default: '' }}')"
              id="var-btn-100ml"
              class="variant-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-sky-400 transition-all cursor-pointer relative"
            >
              <div class="absolute -top-2.5 right-2 bg-sky-900 text-white text-[9px] font-black px-2 py-0.5 rounded-full">
                BEST VALUE
              </div>
              <div class="text-xs font-black text-slate-900">100ml Clinical Double</div>
              <div class="text-sm font-black text-sky-700 mt-1">$79 <span class="text-[10px] text-slate-400 line-through font-normal">$129</span></div>
              <div class="text-[10px] text-slate-500 mt-0.5">Save $50 • Free Full Size</div>
            </button>

          </div>

          <!-- Dynamic Active Variant Summary Strip -->
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <div>
              <span class="text-slate-500">Selected: </span>
              <strong id="selected-variant-label" class="text-slate-900 font-black">50ml Core Treatment (Full 28-Day Cycle • FREE Cryo Spatula)</strong>
            </div>
            <div class="text-right">
              <span id="selected-price-display" class="text-xl font-black text-sky-700">$49.00</span>
              <span id="selected-compare-display" class="text-xs text-slate-400 line-through ml-1">$79.00</span>
            </div>
          </div>

          <div id="selected-variant-gifts" class="bg-white border border-slate-200/80 rounded-xl p-2.5 space-y-1 text-[11px]">
            <span class="font-bold text-sky-900 block">Package Inclusions:</span>
            <ul class="space-y-0.5 text-slate-600">
              <li>✓ FREE Cryo Zinc-Alloy Sculpting Spatula ($18 Value)</li>
              <li>✓ FREE 28-Day Cellular Skin Tracking Journal</li>
              <li>✓ FREE Global Tracked Express Shipping</li>
            </ul>
          </div>

        </div>

        <!-- Buy Action Button -->
        <div class="space-y-3">
          <button
            type="button"
            onclick="openShopifyCartDrawer()"
            class="w-full bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 text-slate-950 font-black text-base sm:text-lg py-4 px-6 rounded-2xl shadow-xl transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98"
          >
            <span>Order Now • 30-Day Money-Back Guarantee</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>

          <div class="flex items-center justify-center gap-4 text-xs text-slate-500 font-medium">
            <span>✓ Free Express Shipping</span>
            <span>•</span>
            <span>✓ 30-Day Money-Back</span>
            <span>•</span>
            <span>✓ 100% Authentic Lab Direct</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- 2. INTERACTIVE 28-DAY VISUAL COMPARISON -->
  <!-- ========================================== -->
  <section class="bg-slate-900 text-white py-12 sm:py-16 px-4 sm:px-6 border-b border-slate-800">
    <div class="max-w-6xl mx-auto space-y-8 sm:space-y-10">
      
      <div class="text-center space-y-2.5 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-1.5 bg-sky-500/20 text-sky-300 text-xs font-black px-3.5 py-1 rounded-full border border-sky-500/30 uppercase tracking-wider">
          <span>28-DAY OPTICAL TOPOGRAPHY PROOF</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-white">Visual Proof: Before & After 28-Day Clinical Trial</h2>
        <p class="text-slate-400 text-xs sm:text-sm">Drag the interactive slider below to inspect dermatological skin topography changes.</p>
      </div>

      <!-- Interactive Split Slider Container -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-8 bg-slate-950 rounded-3xl p-3 sm:p-4 border border-slate-800 shadow-2xl relative overflow-hidden">
          <div class="relative aspect-4/3 sm:aspect-16/10 rounded-2xl overflow-hidden select-none touch-none" id="liquid-slider-container">
            <img
              src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=800&q=80"
              alt="After 28 Days Clinical Treatment"
              class="absolute inset-0 w-full h-full object-cover"
            >
            <div class="absolute top-3 right-3 bg-sky-600/90 backdrop-blur-md text-white text-[11px] font-black px-3 py-1 rounded-full shadow-md z-10">
              DAY 28 • PEPTIDERM
            </div>

            <div id="liquid-before-layer" class="absolute inset-0 overflow-hidden" style="width: 50%;">
              <img
                src="https://images.unsplash.com/photo-1512290900672-1f5511b512c4?auto=format&fit=crop&w=800&q=80"
                alt="Day 0 Baseline Skin"
                class="absolute inset-0 w-full h-full object-cover max-w-none"
                style="width: 100%; height: 100%;"
              >
              <div class="absolute top-3 left-3 bg-slate-900/90 backdrop-blur-md text-slate-200 text-[11px] font-black px-3 py-1 rounded-full shadow-md z-10">
                DAY 0 • BASELINE
              </div>
            </div>

            <div id="liquid-slider-bar" class="absolute top-0 bottom-0 w-1 bg-white cursor-ew-resize z-20 shadow-2xl" style="left: 50%;">
              <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 sm:w-10 sm:h-10 bg-white text-slate-900 rounded-full flex items-center justify-center shadow-2xl border-2 border-sky-600 font-black text-xs">
                ⇄
              </div>
            </div>

            <input
              type="range"
              min="0"
              max="100"
              value="50"
              oninput="document.getElementById('liquid-before-layer').style.width = this.value + '%'; document.getElementById('liquid-slider-bar').style.left = this.value + '%';"
              class="absolute inset-0 opacity-0 cursor-ew-resize w-full h-full z-30"
              aria-label="Before after comparison slider"
            >
          </div>

