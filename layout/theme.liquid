<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#0284c7' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if page_title -%}
      <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- else -%}
      <title>{{ shop.name }}</title>
    {%- endif -%}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <!-- Tailwind CSS CDN for instant rendering in Shopify -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f0f9ff',
                100: '#e0f2fe',
                500: '#0ea5e9',
                600: '#0284c7',
                700: '#0369a1',
                900: '#0c4a6e',
                950: '#082f49',
              }
            }
          }
        }
      }
    </script>

    {{ 'peptiderm-theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="bg-white text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    {% section 'top-announcement' %}
    {% section 'header' %}

    <main id="MainContent" class="flex-grow focus:none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {{ 'peptiderm-theme.js' | asset_url | script_tag }}
  </body>
</html>
